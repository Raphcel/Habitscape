# ─────────────────────────────────────────────────────────────────────────────
# Docker Compose .env file
# Copy this to .env in the same directory as docker-compose.yml
# ─────────────────────────────────────────────────────────────────────────────

# JWT — CHANGE THIS to a long random string in production!
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=local-dev-secret-change-me

# Frontend origin (change if deploying to a custom domain)
CLIENT_ORIGIN=http://localhost:3001

# Google Gemini API key (for AI food summaries)
GEMINI_API_KEY=

# BMI ML — SumoPod/DeepSeek credentials (only needed if using bmi-ml service)
SUMOPOD_API_KEY=change_me
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=deepseek-v4-pro

# Supabase (Storage)
SUPABASE_URL=
SUPABASE_KEY=
