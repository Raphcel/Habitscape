# ── SumoPod / DeepSeek ─────────────────────
SUMOPOD_API_KEY=api_key_here
SUMOPOD_BASE_URL=https://ai.sumopod.com/v1
SUMOPOD_MODEL=deepseek-v4-pro

# ── Model TensorFlow SavedModel ─────────────
TF_MODEL_PATH=weights/best_saved_model
TF_CONFIDENCE_THRESHOLD=0.5
TF_INPUT_SIZE=640

# ── App ─────────────────────────────────────
MAX_IMAGE_SIZE_MB=10
